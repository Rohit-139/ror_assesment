<div style="background-color: LightGray">
	<h1>Log In</h1>

<%= form_with(url: login_path, scope: :signup, local: true) do |form| %>
  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, placeholder: "Enter your email" %>
  </div>

  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, placeholder: "Enter your password" %>
  </div>

  <div class="actions">
    <%= form.submit "Log In" %>
  </div>
<% end %>

<%= link_to "Sign up", home_path %>

</div>