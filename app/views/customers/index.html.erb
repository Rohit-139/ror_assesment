<div>
	<h1 align="center">GoMato food platform</h1>

	<% if @restaurants.present? %>
	<div style="display: flex; flex-wrap: wrap; gap: 20px;">
	<% @restaurants.each do |restaurant| %>
	<div><h3> Name : <%=restaurant.name%></h3>
	<h3> Description : <%=restaurant.description%></h3>
	<h3> Rating : <%=restaurant.rating%></h3> 
	<h3><%= link_to 'see dishes ',dishes_path(restaurant_id: restaurant.id) %></h3>
</div>
	<% end %>
	</div>
	<% else %>
	<h2>Currently no restaurants are opened </h2>
	  <% end %>
</div>